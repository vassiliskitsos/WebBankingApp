@page "/login"
<PageTitle>Σύνδεση - WebBanking</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h3 class="card-title text-center mb-3">Σύνδεση</h3>
                    <p class="text-muted text-center small mb-4">
                        Εισάγετε τα στοιχεία σας για πρόσβαση στον λογαριασμό σας (US-02).
                    </p>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm EditContext="@editContext" OnSubmit="HandleLoginAsync">
                        <div class="mb-3">
                            <label for="username" class="form-label">Όνομα Χρήστη (Username)</label>
                            <InputText id="username" class="form-control" @bind-Value="model.Username" placeholder="π.χ. theofania" />
                            <ValidationMessage For="@(() => model.Username)" class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Κωδικός Πρόσβασης</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" placeholder="Εισάγετε τον κωδικό σας" />
                            <ValidationMessage For="@(() => model.Password)" class="text-danger small" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Γίνεται σύνδεση...</span>
                            }
                            else
                            {
                                <span>Σύνδεση</span>
                            }
                        </button>
                    </EditForm>

                    <hr class="my-4" />

                    <div class="text-center">
                        <span class="text-muted small">Δεν έχετε λογαριασμό;</span>
                        <a href="/register" class="small fw-semibold text-decoration-none ms-1">Εγγραφή</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
