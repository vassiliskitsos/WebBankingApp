# Αντιγράψτε σε .env (το .env δεν ανεβαίνει στο repo)
POSTGRES_DB=webbanking
POSTGRES_USER=webbanking
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# JWT (χρησιμοποιήστε μακρύ τυχαίο κλειδί)
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ISSUER=WebBankingApp
JWT_EXPIRES_MINUTES=60
